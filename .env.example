# Generate with: npm run generate-key
# Changing this orphans the stored Monarch session — you would have to
# reconnect. It never needs to change otherwise.
NORTHSTAR_ENCRYPTION_KEY=

# Days before the app starts asking you to refresh.
NORTHSTAR_STALENESS_DAYS=7

# Leave false for localhost. Set true only behind HTTPS.
NORTHSTAR_SECURE_COOKIES=false
