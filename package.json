{
  "name": "northstar-forecast",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "build:pages": "vite build --mode gh-pages",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit && npm run lint --workspace @northstar/engine",
    "test": "vitest run && npm run test --workspace @northstar/engine"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@northstar/engine": "*",
    "@vitejs/plugin-react": "^5.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.2.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.2.7"
  }
}
